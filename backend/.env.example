NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (a replica set is required for transactions).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/burger-house?retryWrites=true&w=majority

# A SEPARATE database used only by "npm run test:integration". The name MUST end with -test
# because the tests erase it. Never point this at real data.
MONGODB_URI_TEST=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/burger-house-test?retryWrites=true&w=majority

# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string-32-chars-min

# The exact address of the website (used for CORS and the CSRF origin check). No trailing slash.
FRONTEND_ORIGIN=http://localhost:3000

# Leave empty (the login cookie belongs to the API address itself)
COOKIE_DOMAIN=

# Comma-separated hostnames allowed for menu images, for example: res.cloudinary.com
ALLOWED_IMAGE_HOSTS=

LOG_LEVEL=info

# How many proxies sit between visitors and this server. 0 locally. On Render/Vercel set it by measuring:
# see docs/DEPLOYMENT.md, step "Check how the server sees visitors".
TRUST_PROXY=0

# Optional shared secret (32+ characters) that your website's server sends so it is not rate limited
# like a visitor. Use the SAME value on Vercel. Leave empty locally.
INTERNAL_API_KEY=

# Admin sign-in session limits
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12