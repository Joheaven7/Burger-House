  "format": "prettier --write .",
  "test": "tsx --test src/tests/pricing.test.ts src/tests/status.test.ts src/tests/time.test.ts src/tests/security.test.ts src/tests/validators.test.ts src/tests/http.test.ts",
  "test:integration": "tsx --test src/tests/integration.test.ts",
  "seed:dev": "tsx src/scripts/seed-dev.ts",
  "admin:create": "tsx src/scripts/bootstrap-admin.ts",
  "backup": "tsx src/scripts/backup-export.ts",
